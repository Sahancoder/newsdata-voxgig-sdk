      h: "Market Id"
      n: "market_id"
      r: false
      sh: "Unique market identifiers for the tickers in `symbol` — the values accepted by the `market_id` filter."
      t: [
        "`$ONE`"
        [
          "`$ARRAY`"
          "`$NULL`"
        ]
      ]
    }
