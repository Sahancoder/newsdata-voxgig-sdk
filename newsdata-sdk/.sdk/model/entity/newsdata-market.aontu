      h: "Creator"
      n: "creator"
      r: false
      sh: "Article author(s)."
      t: [
        "`$ONE`"
        [
          "`$ARRAY`"
          "`$NULL`"
        ]
      ]
    }
    datatype: {
      h: "Datatype"
      n: "datatype"
      r: false
      sh: "Content type, e.g."
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Short article description."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    duplicate: {
      h: "Duplicate"
      n: "duplicate"
      r: false
      sh: "Whether the article is a duplicate of another article."
      t: "`$BOOLEAN`"
    }
    fetched_at: {
      h: "Fetched At"
      n: "fetched_at"
      r: false
      sh: "When the article was collected, `YYYY-MM-DD HH:MM:SS`."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
